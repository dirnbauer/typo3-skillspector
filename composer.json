{
    "name": "webconsulting/skillspector",
    "description": "Advisory security, NVIDIA SkillSpector and license checks for nr_llm skills.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Kurt Dirnbauer",
            "email": "dirnbauer@webconsulting.at",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "netresearch/nr-llm": "^0.34 || ^0.35",
        "symfony/process": "^7.0",
        "symfony/yaml": "^7.0",
        "typo3/cms-backend": "^14.3.7",
        "typo3/cms-core": "^14.3.7",
        "typo3/cms-scheduler": "^14.3.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.4 || ^13.0",
        "saschaegerer/phpstan-typo3": "^3.0.1",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\Skillspector\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\Skillspector\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "ci": [
            "@ci:cgl",
            "@ci:phpstan",
            "@ci:tests:unit",
            "@ci:tests:functional"
        ],
        "ci:cgl": "php-cs-fixer fix --config .php-cs-fixer.dist.php --diff --verbose",
        "ci:phpstan": "phpstan analyse --configuration phpstan.neon --no-progress",
        "ci:tests:functional": "phpunit --configuration Build/phpunit/FunctionalTests.xml",
        "ci:tests:unit": "phpunit --configuration Build/phpunit/UnitTests.xml"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "skillspector",
            "version": "1.0.0",
            "web-dir": ".Build/public",
            "Package": {
                "providesPackages": []
            }
        }
    }
}
